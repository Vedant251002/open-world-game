# Which gateway answers. Optional: with no AI_PROVIDER set, the game uses
# whichever key below is actually present, Groq first.
#AI_PROVIDER=groq

# --- Groq (recommended) -------------------------------------------------
# Free, no credit card, and the only one here that can be held to a JSON
# schema — the reply is then guaranteed to parse, which removes the failure
# the old free models had of stopping mid-string after forty seconds.
#
# Get a key: https://console.groq.com  ->  API Keys  ->  Create API Key
#
# Free plan limits for openai/gpt-oss-120b, as of September 2026:
#   30 requests/min, 1,000 requests/day, 8,000 tokens/min, 200,000 tokens/day
# Tokens per minute is the one that bites: a full prompt runs a few thousand,
# so sustained play is roughly an order a minute. The archetype cache absorbs
# most of it, and a repeated order never leaves the machine at all.
GROQ_API_KEY=
# openai/gpt-oss-20b is the same limits and faster; 120b plans better.
GROQ_MODEL=openai/gpt-oss-120b

# --- OpenCode Zen (the original, kept as a fallback) --------------------
# Works, costs nothing, and the deployed proxy already holds a key for it.
# Slow — the better part of a minute — with no structured output, and its
# free models truncate a long plan.
OPENCODE_API_KEY=
OPENCODE_MODEL=nemotron-3-ultra-free

# Only needed to point a build at a dev deployment of proxy/worker.js.
#OPENCODE_PROXY_URL=
